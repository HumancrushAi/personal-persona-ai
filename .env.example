# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).
#
# VITE_* vars are inlined into the client bundle at BUILD time — they must be
# present when Vercel runs the build, not just at runtime.

# --- Supabase (client, build-time) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_ANON_KEY="eyJ..."

# --- Supabase (server, runtime) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_ANON_KEY="eyJ..."
# Service role — server-only, full DB access. NEVER expose to client / no VITE_ prefix.
# Supabase dashboard -> Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# --- AI providers (server, runtime) ---
# Chat replies -> OpenRouter (use an NSFW-permitting model; openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-xxx"
# Optional: override the chat model. Default = sao10k/l3.1-euryale-70b
OPENROUTER_MODEL="sao10k/l3.1-euryale-70b"
# Selfies (image) + voice notes (TTS) -> OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-xxx"
# Optional overrides: OPENAI_IMAGE_MODEL (default gpt-image-1), OPENAI_TTS_MODEL (default gpt-4o-mini-tts)
# Optional: used for OpenRouter attribution header
PUBLIC_SITE_URL="https://your-domain.com"

# --- Authorize.Net (server, runtime, LIVE) ---
AUTHORIZE_NET_API_LOGIN_ID="xxx"
AUTHORIZE_NET_TRANSACTION_KEY="xxx"
AUTHORIZE_NET_CLIENT_KEY="xxx"
AUTHORIZE_NET_SIGNATURE_KEY="xxx"
