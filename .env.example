# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).
#
# VITE_* vars are inlined into the client bundle at BUILD time — they must be
# present when Vercel runs the build, not just at runtime.

# --- Supabase (client, build-time) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_ANON_KEY="eyJ..."

# --- Supabase (server, runtime) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_ANON_KEY="eyJ..."
# Service role — server-only, full DB access. NEVER expose to client / no VITE_ prefix.
# Supabase dashboard -> Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# --- AI providers (server, runtime) ---
# Chat replies -> OpenRouter (use an NSFW-permitting model; openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-xxx"
# Optional: override the chat model. Default = sao10k/l3.1-euryale-70b
OPENROUTER_MODEL="sao10k/l3.1-euryale-70b"
# Voice notes (TTS) -> OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-xxx"
# Optional overrides: OPENAI_TTS_MODEL (default gpt-4o-mini-tts)
# --- RunPod (explicit video; images only with an uncensored endpoint) ---
# Video runs a private LoRA-tuned WAN i2v endpoint on the companion's own photo.
# Falls back to Replicate if unset, or if the companion has no hosted http(s)
# photo to use as the source frame.
RUNPOD_API_KEY="rpa_xxx"
# Private serverless endpoint ID for image-to-video. Required for RunPod video.
RUNPOD_VIDEO_ENDPOINT="yrrg1bu75pg5vr"
# Image-to-image endpoint. LEAVE UNSET unless it runs UNCENSORED weights.
# Do NOT point this at RunPod's public "black-forest-labs-flux-1-kontext-dev":
# that model refuses nudity at the weights level (it will move the subject, change
# the scene, and keep her fully clothed), and enable_safety_checker=false does not
# change that. The job still reports COMPLETED, so the user gets charged for a
# clothed photo. Set this only to your own ComfyUI serverless endpoint running a
# Pony/SDXL NSFW checkpoint; unset, explicit images stay on Replicate.
RUNPOD_IMAGE_ENDPOINT=""
# Image-to-image for CLOTHED work: promo shots, banner plates, wardrobe and
# scene edits. One shot, ~10s, carries her face exactly. RunPod's public FLUX.1
# Kontext is fine here and this is the ONLY variable it may go in — it must not
# go in RUNPOD_IMAGE_ENDPOINT above, which the paid chat selfie reads.
# Verified on a live job: with an explicit nude prompt, clothing negatives and
# enable_safety_checker=false it still returned the subject clothed, COMPLETED
# and billed. The studio routes nudity away from it via requestIsNude().
RUNPOD_KONTEXT_ENDPOINT="black-forest-labs-flux-1-kontext-dev"
# Optional tuning: RUNPOD_IMAGE_STEPS (28), RUNPOD_IMAGE_GUIDANCE (2.5),
# RUNPOD_IMAGE_SIZE (1024*1024), RUNPOD_VIDEO_FPS (16),
# RUNPOD_VIDEO_FRAMES (82 -> ~5s clip), RUNPOD_VIDEO_STEPS (10)
#
# Chat photos are one frame cut out of a short clip on the video endpoint, so
# they have their own knobs: RUNPOD_STILL_FRAMES (81) and RUNPOD_STILL_STEPS
# (26).
#
# Frames is NOT a cost dial, which is how it was previously treated. WAN i2v
# paces an action across a fixed arc — the video path here uses 82 frames and
# calls it the endpoint's tuned default. Run the same model for 49 and it does
# not perform the action faster, it performs about 60% of it and stops; the
# frame we then cut out of the tail is the subject still morphing out of her
# clothed portrait. Do not lower this below ~81 to save GPU time: the money it
# saves is spent on photos users complain about.
#
# RUNPOD_STILL_SIZE and RUNPOD_STILL_GUIDANCE are unset (off) by default: both
# were once defaults nobody had rendered, and photos got worse. Check a change
# with scripts/test-still.ts before setting either. Size is the biggest
# remaining lever on image quality. With no size sent, the worker renders its own default 640x640
# square, which start-frame.server.ts exists entirely to pad for — and on a
# head-to-knees frame that leaves the anatomy the request was about about forty
# pixels wide. WAN's native portrait buckets are 480x832 and 720x1280, either of
# which roughly doubles the vertical resolution on the subject at similar cost
# AND is in-distribution where a square is not. Ask the endpoint's operator
# whether its ComfyUI workflow exposes width/height, then set e.g.
#   RUNPOD_STILL_SIZE="480*832"

# --- Replicate (fallback for selfies/video; still used for character art) ---
# Images (selfies + character art) -> Replicate NSFW model when set, else OpenAI (SFW).
REPLICATE_API_TOKEN="r8_xxx"
# Optional: swap the image model without code. Default = Pony Realism version.
REPLICATE_IMAGE_VERSION="fb4f086702d6a301ca32c170d926239324a7b7b2f0afc3d232a9c4be382dc3fa"
# Video (chat "send me a video" + 🎬 button) -> Replicate image-to-video, using
# the companion's photo as the start frame. Official model, called by name.
# Optional overrides:
REPLICATE_VIDEO_MODEL="wan-video/wan-2.5-i2v-fast"
REPLICATE_VIDEO_RESOLUTION="720p"   # 720p or 1080p
REPLICATE_VIDEO_DURATION="5"        # seconds (2-15)
# Required for video (webhook callback URL) + OpenRouter attribution header.
PUBLIC_SITE_URL="https://your-domain.com"
# Selfies auto-fall back gpt-image-1 -> dall-e-3; pin OPENAI_IMAGE_MODEL to force one.

# --- Auth options (client, build-time) ---
# Show "Continue with Google" only after configuring the Google provider in
# Supabase (Auth -> Providers) + Google Cloud. Leave unset/false to hide it.
VITE_ENABLE_GOOGLE_AUTH="false"

# --- Email (Resend) ---
# Auth emails (confirm signup, reset password) are sent by Supabase via SMTP.
# Put this key in Supabase -> Auth -> SMTP as the PASSWORD (username: "resend",
# host: smtp.resend.com, port: 465). See docs/email-setup.md.
# The same key also sends app notification emails (from EMAIL_FROM).
RESEND_API_KEY="re_xxx"
EMAIL_FROM="HumanCrush <notifications@your-domain.com>"

# --- Web push notifications (VAPID) ---
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="B..."
VITE_VAPID_PUBLIC_KEY="B..."   # same value, exposed to the browser
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:admin@your-domain.com"

# --- Authorize.Net (server, runtime, LIVE) ---
AUTHORIZE_NET_API_LOGIN_ID="xxx"
AUTHORIZE_NET_TRANSACTION_KEY="xxx"
AUTHORIZE_NET_CLIENT_KEY="xxx"
AUTHORIZE_NET_SIGNATURE_KEY="xxx"

# --- Scheduled jobs ---
# Set the SAME value in Vercel; Vercel auto-sends it as Bearer auth on cron calls.
CRON_SECRET="generate-a-random-string"

# --- Prompt refiner (xAI / Grok) ---
# Rewrites the user's one-line request into a full generation prompt before it
# goes to RunPod. Optional: without it the keyword prompt builders are used, so
# generation still works, just with less understanding of unusual requests.
XAI_API_KEY="xai-..."
# Optional model override. Default = grok-4.6
XAI_MODEL="grok-4.6"

# --- Support tickets ---
# Where the support widget sends new tickets. Unset, tickets are still saved and
# visible in the admin panel, but no alert email is sent — so set it.
# The alert's Reply-To is the customer, so replying from this inbox reaches them
# directly; replying in the admin panel records it on the ticket as well.
SUPPORT_EMAIL="you@example.com"
