# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables (Production + Preview).
#
# VITE_* vars are inlined into the client bundle at BUILD time — they must be
# present when Vercel runs the build, not just at runtime.

# --- Supabase (client, build-time) ---
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_ANON_KEY="eyJ..."

# --- Supabase (server, runtime) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_ANON_KEY="eyJ..."
# Service role — server-only, full DB access. NEVER expose to client / no VITE_ prefix.
# Supabase dashboard -> Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# --- Lovable AI gateway (server, runtime) — powers chat, image gen, TTS ---
LOVABLE_API_KEY="your-lovable-ai-key"

# --- Stripe (server, runtime) ---
# Dashboard -> Developers -> API keys / Webhooks.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs — create one Product+Price per pack/tier, paste the price_... ids.
STRIPE_PRICE_STARTER="price_xxx"       # 50 credits, $5 one-time
STRIPE_PRICE_LOVER="price_xxx"         # 120 credits, $10 one-time
STRIPE_PRICE_DEVOTED="price_xxx"       # 350 credits, $25 one-time
STRIPE_PRICE_SUB_FLIRT="price_xxx"     # 800 credits/mo, $12.99 recurring
STRIPE_PRICE_SUB_LOVER="price_xxx"     # 2500 credits/mo, $24.99 recurring
STRIPE_PRICE_SUB_SOULMATE="price_xxx"  # 8000 credits/mo, $49.99 recurring
# Absolute app origin for Checkout redirects (optional; falls back to request host).
PUBLIC_APP_URL="https://your-app.vercel.app"
